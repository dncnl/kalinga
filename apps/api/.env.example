PORT=8081

# Firebase Admin credentials. Leaving both unset falls back to ambient
# credentials (gcloud auth application-default login, or Cloud Run's own
# service account) -- fine for Firestore/Auth/Translate/Speech/Vertex, but
# NOT for signed Storage URLs (medications/upload-url,
# observations/upload-url): `gcloud auth application-default login`
# credentials have no private key to sign with, and fail with "Cannot sign
# data without `client_email`" -- confusingly reported to the caregiver as a
# raw HTML error page rather than that message (see lib/signedUploadUrl.js).
# If you're touching the photo-scan or voice-log upload flow locally, set
# this to a real service account key's JSON (one line, e.g.
# `FIREBASE_SERVICE_ACCOUNT=$(cat key.json)` or paste it inline).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=

# Needs Cloud Speech-to-Text API and Cloud Translation API enabled on the
# same GCP project as FIREBASE_SERVICE_ACCOUNT, and that service account
# granted roles/speech.client + roles/cloudtranslate.user (or broader).
# No separate key needed — reuses FIREBASE_SERVICE_ACCOUNT.

# LLM provider for /rag/ask answers and observation extraction (see
# src/lib/llmClient.js). Defaults to Vertex AI (Gemini) — same project/
# billing as everything else, no separate API key needed; just needs the
# Vertex AI API (aiplatform.googleapis.com) enabled on the project and
# `gcloud auth application-default login` run locally (or the deployed
# service's own service account granted roles/aiplatform.user).
# VERTEX_AI_LOCATION=us-central1

# Fallback/alternate provider (LLM_PROVIDER=openrouter): free-tier, no
# billing required, useful if Vertex AI is unavailable.
OPENROUTER_API_KEY=

# Shared secret for POST /internal/rag/ingest-gcs (routes/ragIngest.js) —
# must match the RAG_INGEST_SECRET set on the ingestRagUpload Cloud
# Function (packages/kalinga_firestore_package/functions). Unset = that
# route refuses every request. See functions/README.md for setup.
RAG_INGEST_SECRET=
