PORT=8081

# Firebase Admin credentials. Leave both unset to use ambient credentials
# (e.g. gcloud auth application-default login, or Cloud Run's service account).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=

# Needs Cloud Speech-to-Text API and Cloud Translation API enabled on the
# same GCP project as FIREBASE_SERVICE_ACCOUNT, and that service account
# granted roles/speech.client + roles/cloudtranslate.user (or broader).
# No separate key needed — reuses FIREBASE_SERVICE_ACCOUNT.

# LLM provider for /rag/ask answers and observation extraction (see
# src/lib/llmClient.js). Defaults to Vertex AI (Gemini) — same project/
# billing as everything else, no separate API key needed; just needs the
# Vertex AI API (aiplatform.googleapis.com) enabled on the project and
# `gcloud auth application-default login` run locally (or the deployed
# service's own service account granted roles/aiplatform.user).
# VERTEX_AI_LOCATION=us-central1

# Fallback/alternate provider (LLM_PROVIDER=openrouter): free-tier, no
# billing required, useful if Vertex AI is unavailable.
OPENROUTER_API_KEY=
