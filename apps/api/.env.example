# ============================================================
# Kalinga API — Environment Variables Template
# Copy this file to .env and fill in the values for your mode.
# NEVER commit .env or serviceAccountKey.json to git.
# ============================================================

# -----------------------------------------------------------
# SHARED
# -----------------------------------------------------------
PORT=3000
FIREBASE_PROJECT_ID=kalinga-bc97f

# -----------------------------------------------------------
# LOCAL DEVELOPMENT (emulator mode)
# -----------------------------------------------------------
# Uncomment these two lines when running against the local
# Firebase Emulator Suite. Comment them out for production.
#
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#
# When emulator vars are set, no credentials file is needed.
# Leave GOOGLE_APPLICATION_CREDENTIALS commented out below.

# -----------------------------------------------------------
# PRODUCTION (live Firebase project: kalinga-bc97f)
# -----------------------------------------------------------
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" → save as serviceAccountKey.json
# 3. Place serviceAccountKey.json in apps/api/  (it is git-ignored)
# 4. Uncomment the line below and ensure the emulator vars above
#    are commented out.
#
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
