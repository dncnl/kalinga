PORT=8081

# Firebase Admin credentials. Leave both unset to use ambient credentials
# (e.g. gcloud auth application-default login, or Cloud Run's service account).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=

# Needs Cloud Speech-to-Text API and Cloud Translation API enabled on the
# same GCP project as FIREBASE_SERVICE_ACCOUNT, and that service account
# granted roles/speech.client + roles/cloudtranslate.user (or broader).
# No separate key needed — reuses FIREBASE_SERVICE_ACCOUNT.

# OpenRouter API key, for extracting structured observation data from the
# transcript (sleep/appetite/mood, safety flags). Using a free-tier model
# (openai/gpt-oss-20b:free) — see src/lib/extractObservation.js if it
# disappears from OpenRouter's free lineup.
OPENROUTER_API_KEY=
